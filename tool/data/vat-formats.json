  "IE": {
    "prefix": "IE",
    "body": "^([0-9]{7}[A-W]|[0-9][A-Z*+][0-9]{5}[A-W]|[0-9]{7}[A-W][A-IW])$",
    "maxLen": 9,
    "example": null
  },
  "IT": {
    "prefix": "IT",
    "body": "^[0-9]{11}$",
    "maxLen": 11,
    "example": null
  },
  "LT": {
    "prefix": "LT",
    "body": "^([0-9]{9}|[0-9]{12})$",
    "maxLen": 12,
    "example": null
