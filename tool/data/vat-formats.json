{
  "_source": "Structures per docs/business-identifiers-design.md, table 'VatId'. Keys are ISO 3166-1 alpha-2 except XI (Northern Ireland), which is a VAT prefix rather than a country. 'prefix' is the string written before the body; 'body' is an anchored regex for everything after it; 'maxLen' is the body's longest permitted length; 'example' is a published number or null.",
  "AT": {
    "prefix": "ATU",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "ATU16210507"
  },
  "BE": {
    "prefix": "BE",
    "body": "^[01][0-9]{9}$",
    "maxLen": 10,
    "example": "BE0417497106"
  },
  "BG": {
    "prefix": "BG",
    "body": "^[0-9]{9,10}$",
    "maxLen": 10,
    "example": "BG175074752"
  },
  "CY": {
    "prefix": "CY",
    "body": "^[0-9]{8}[A-Z]$",
    "maxLen": 9,
    "example": "CY10259033P"
  },
  "CZ": {
    "prefix": "CZ",
    "body": "^[0-9]{8,10}$",
    "maxLen": 10,
    "example": "CZ00177041"
  },
  "DE": {
    "prefix": "DE",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "DE129274202"
  },
  "DK": {
    "prefix": "DK",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "DK13585628"
  },
  "EE": {
    "prefix": "EE",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "EE100594102"
  },
  "ES": {
    "prefix": "ES",
    "body": "^[A-Z0-9][0-9]{7}[A-Z0-9]$",
    "maxLen": 9,
    "example": "ESA28015865"
  },
  "FI": {
    "prefix": "FI",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "FI20774740"
  },
  "FR": {
    "prefix": "FR",
    "body": "^[0-9A-HJ-NP-Z]{2}[0-9]{9}$",
    "maxLen": 11,
    "example": "FR84919434894"
  },
  "GB": {
    "prefix": "GB",
    "body": "^([0-9]{9}|[0-9]{12}|GD[0-9]{3}|HA[0-9]{3}|(GD|HA)8888[0-9]{5})$",
    "maxLen": 12,
    "example": "GB220430231"
  },
  "GR": {
    "prefix": "EL",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "EL094259216"
  },
  "HR": {
    "prefix": "HR",
    "body": "^[0-9]{11}$",
    "maxLen": 11,
    "example": "HR33392005961"
  },
  "HU": {
    "prefix": "HU",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "HU10625790"
  },
  "IE": {
    "prefix": "IE",
    "body": "^([0-9]{7}[A-W]|[0-9][A-Z*+][0-9]{5}[A-W]|[0-9]{7}[A-W][A-IW])$",
    "maxLen": 9,
    "example": "IE4749148U"
  },
  "IT": {
    "prefix": "IT",
    "body": "^[0-9]{11}$",
    "maxLen": 11,
    "example": "IT03656470360"
  },
  "LT": {
    "prefix": "LT",
    "body": "^([0-9]{9}|[0-9]{12})$",
    "maxLen": 12,
    "example": "LT119511515"
  },
  "LU": {
    "prefix": "LU",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "LU15027442"
  },
  "LV": {
    "prefix": "LV",
    "body": "^[0-9]{11}$",
    "maxLen": 11,
    "example": "LV40003032949"
  },
  "MT": {
    "prefix": "MT",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "MT11679112"
  },
  "NL": {
    "prefix": "NL",
    "body": "^[0-9]{9}B[0-9]{2}$",
    "maxLen": 12,
    "example": "NL002455799B11"
  },
  "PL": {
    "prefix": "PL",
    "body": "^[0-9]{10}$",
    "maxLen": 10,
    "example": "PL7742372663"
  },
  "PT": {
    "prefix": "PT",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "PT505060515"
  },
  "RO": {
    "prefix": "RO",
    "body": "^[0-9]{2,10}$",
    "maxLen": 10,
    "example": "RO18547290"
  },
  "SE": {
    "prefix": "SE",
    "body": "^[0-9]{12}$",
    "maxLen": 12,
    "example": "SE556034348401"
  },
  "SI": {
    "prefix": "SI",
    "body": "^[0-9]{8}$",
    "maxLen": 8,
    "example": "SI82646716"
  },
  "SK": {
    "prefix": "SK",
    "body": "^[0-9]{10}$",
    "maxLen": 10,
    "example": "SK7120001713"
  },
  "CH": {
    "prefix": "CHE",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "CHE116281710"
  },
  "XI": {
    "prefix": "XI",
    "body": "^([0-9]{9}|[0-9]{12}|GD[0-9]{3}|HA[0-9]{3}|(GD|HA)8888[0-9]{5})$",
    "maxLen": 12,
    "example": null
  },
  "NO": {
    "prefix": "NO",
    "body": "^[0-9]{9}MVA$",
    "maxLen": 12,
    "example": "NO995525828MVA"
  },
  "RS": {
    "prefix": "RS",
    "body": "^[0-9]{9}$",
    "maxLen": 9,
    "example": "RS101134702"
  },
  "TR": {
    "prefix": "TR",
    "body": "^[0-9]{10}$",
    "maxLen": 10,
    "example": "TR4540536920"
  }
}
