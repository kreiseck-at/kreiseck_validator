    "validator",
    "validation",
    "iban",
    "bic",
    "email",
    "phone",
    "url",
    "host",
    "credit-card",
    "license-plate",
    "imei",
    "iccid",
    "mac-address",
    "vin",
    "postal-code",
    "luhn",
    "mod-97",
    "e164",
    "dach",
    "austria",
    "germany",
    "switzerland",
    "typescript",
    "zero-dependency",
    "normalize",
    "format",
    "vat",
    "vat-id",
    "ust-id",
    "swift",
    "gtin",
    "ean",
    "barcode",
    "firmenbuch"
  ],
  "license": "Apache-2.0",
  "author": "Kreiseck Software Solutions (https://kreiseck.com)",
  "homepage": "https://kreiseck.com",
  "repository": {
